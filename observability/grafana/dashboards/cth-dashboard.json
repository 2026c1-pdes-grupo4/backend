{
  "id": null,
  "uid": "cth-backend-dashboard",
  "title": "CTH Backend — Observability",
  "tags": ["cth", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"cth\"}[1m])) by (uri, method)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{application=\"cth\",outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[1m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{application=\"cth\"}[1m]))",
          "legendFormat": "Error Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "alert": {
        "name": "High Error Rate",
        "message": "Error rate is above 5%",
        "conditions": [
          {
            "type": "query",
            "query": { "params": ["A", "1m", "now"] },
            "reducer": { "type": "avg", "params": [] },
            "evaluator": { "type": "gt", "params": [5] }
          }
        ],
        "executionErrorState": "alerting",
        "noDataState": "no_data",
        "frequency": "1m",
        "handler": 1
      }
    },
    {
      "id": 3,
      "title": "P95 Response Time (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
          "expr": "histogram_quantile(0.95, sum by(le) (rate(http_server_requests_seconds_bucket{application=\"cth\"}[1m]))) * 1000",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
          "expr": "histogram_quantile(0.50, sum by(le) (rate(http_server_requests_seconds_bucket{application=\"cth\"}[1m]))) * 1000",
          "legendFormat": "p50 (median)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 4,
      "title": "Active HTTP Requests",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
          "expr": "sum(http_server_requests_seconds_count{application=\"cth\"})",
          "legendFormat": "Total Requests",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "JVM Memory Used",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-cth" },
          "expr": "jvm_memory_used_bytes{application=\"cth\", area=\"heap\"}",
          "legendFormat": "Heap Used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 6,
      "title": "Application Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki-cth" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-cth" },
          "expr": "{app=\"cth\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
